  "author": {
    "name": "Solaris Technologies",
    "email": "shehryar@solaristek.com",
    "url": "https://solaristek.com"
  },
  "homepage": "https://github.com/Shaisolaris/solaris-dev-shop-plugins",
  "repository": "https://github.com/Shaisolaris/solaris-dev-shop-plugins",
  "license": "MIT",
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/chief-of-staff/SKILL.md",
      "interface": {
