        "developerName": "Solaris Technologies",
        "category": "Productivity",
        "websiteURL": "https://github.com/Shaisolaris/solaris-dev-shop-plugins",
        "supportURL": "https://github.com/Shaisolaris/solaris-dev-shop-plugins/issues",
        "privacyPolicyURL": "https://www.solaristek.com/privacy-policy/",
        "termsOfServiceURL": "https://github.com/Shaisolaris/solaris-dev-shop-plugins/blob/v0.63.0/LICENSE",
        "composerIcon": "./assets/native-plugin-icon.png",
        "composerIconDark": "./assets/native-plugin-icon.png",
        "logo": "./assets/native-plugin-icon.png",
        "logoDark": "./assets/native-plugin-icon.png",
        "defaultPrompt": [
          "Route a code review to the appropriate Solaris specialists.",
